# File: .env.example
# Purpose: Documents optional runtime configuration without containing real credentials.
# Author: Raushan Raj

QUALYNTRA_HOST=127.0.0.1
QUALYNTRA_PORT=4317
QUALYNTRA_DATA_DIR=.qualyntra
QUALYNTRA_LOG_LEVEL=info
QUALYNTRA_DEFAULT_PROVIDER=mock
QUALYNTRA_ALLOW_NETWORK=false
QUALYNTRA_OPENAI_BASE_URL=
QUALYNTRA_OPENAI_API_KEY=
QUALYNTRA_OPENAI_MODEL=
QUALYNTRA_DEEPEVAL_PYTHON=python3

# Control-plane API bootstrap. Keep real tokens outside source control.
QUALYNTRA_API_TOKEN=
QUALYNTRA_API_ACTOR_ID=local-service
QUALYNTRA_API_ORGANIZATION_ID=
QUALYNTRA_API_MAX_BODY_BYTES=1048576
QUALYNTRA_API_MAX_PAGE_SIZE=100
QUALYNTRA_API_RATE_LIMIT_PER_MINUTE=120
QUALYNTRA_API_CORS_ORIGINS=

# Enterprise identity / OIDC. Network policy must allow the issuer/JWKS hosts.
QUALYNTRA_OIDC_ISSUER=
QUALYNTRA_OIDC_AUDIENCES=
QUALYNTRA_OIDC_DISCOVERY_URL=
QUALYNTRA_OIDC_ALLOWED_ALGORITHMS=RS256,ES256
QUALYNTRA_OIDC_CLOCK_SKEW_SECONDS=60
QUALYNTRA_OIDC_JWKS_CACHE_TTL_SECONDS=300
QUALYNTRA_OIDC_REQUEST_TIMEOUT_MS=5000
QUALYNTRA_OIDC_MAX_TOKEN_BYTES=16384
QUALYNTRA_OIDC_MAX_TOKEN_AGE_SECONDS=
QUALYNTRA_OIDC_ACCEPTED_TOKEN_TYPES=JWT,at+jwt
QUALYNTRA_OIDC_REQUIRE_TOKEN_TYPE=false
QUALYNTRA_OIDC_ALLOW_INSECURE_LOCALHOST=false
QUALYNTRA_OIDC_GROUP_CLAIM=groups
QUALYNTRA_OIDC_ORGANIZATION_CLAIM=qualyntra_org
QUALYNTRA_OIDC_WORKSPACE_CLAIM=
QUALYNTRA_OIDC_PROJECT_CLAIM=
QUALYNTRA_OIDC_ENVIRONMENT_CLAIM=
QUALYNTRA_OIDC_DISPLAY_NAME_CLAIMS=name,preferred_username,email
QUALYNTRA_OIDC_SERVICE_SUBJECTS=
QUALYNTRA_OIDC_ROLE_MAPPINGS=
