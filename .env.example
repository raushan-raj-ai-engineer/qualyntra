# File: .env.example
# Purpose: Documents optional runtime configuration without containing real credentials.
# Author: Raushan Raj

QUALYNTRA_HOST=127.0.0.1
QUALYNTRA_PORT=4317
QUALYNTRA_DATA_DIR=.qualyntra
QUALYNTRA_LOG_LEVEL=info
QUALYNTRA_DEFAULT_PROVIDER=mock
QUALYNTRA_ALLOW_NETWORK=false
QUALYNTRA_OPENAI_BASE_URL=
QUALYNTRA_OPENAI_API_KEY=
QUALYNTRA_OPENAI_MODEL=
QUALYNTRA_DEEPEVAL_PYTHON=python3

# Control-plane API bootstrap. Keep real tokens outside source control.
QUALYNTRA_API_TOKEN=
QUALYNTRA_API_ACTOR_ID=local-service
QUALYNTRA_API_ORGANIZATION_ID=
QUALYNTRA_API_MAX_BODY_BYTES=1048576
QUALYNTRA_API_MAX_PAGE_SIZE=100
QUALYNTRA_API_RATE_LIMIT_PER_MINUTE=120
QUALYNTRA_API_CORS_ORIGINS=

# Enterprise identity / OIDC. Network policy must allow the issuer/JWKS hosts.
QUALYNTRA_OIDC_ISSUER=
QUALYNTRA_OIDC_AUDIENCES=
QUALYNTRA_OIDC_DISCOVERY_URL=
QUALYNTRA_OIDC_ALLOWED_ALGORITHMS=RS256,ES256
QUALYNTRA_OIDC_CLOCK_SKEW_SECONDS=60
QUALYNTRA_OIDC_JWKS_CACHE_TTL_SECONDS=300
QUALYNTRA_OIDC_REQUEST_TIMEOUT_MS=5000
QUALYNTRA_OIDC_MAX_TOKEN_BYTES=16384
QUALYNTRA_OIDC_MAX_TOKEN_AGE_SECONDS=
QUALYNTRA_OIDC_ACCEPTED_TOKEN_TYPES=JWT,at+jwt
QUALYNTRA_OIDC_REQUIRE_TOKEN_TYPE=false
QUALYNTRA_OIDC_ALLOW_INSECURE_LOCALHOST=false
QUALYNTRA_OIDC_GROUP_CLAIM=groups
QUALYNTRA_OIDC_ORGANIZATION_CLAIM=qualyntra_org
QUALYNTRA_OIDC_WORKSPACE_CLAIM=
QUALYNTRA_OIDC_PROJECT_CLAIM=
QUALYNTRA_OIDC_ENVIRONMENT_CLAIM=
QUALYNTRA_OIDC_DISPLAY_NAME_CLAIMS=name,preferred_username,email
QUALYNTRA_OIDC_SERVICE_SUBJECTS=
QUALYNTRA_OIDC_ROLE_MAPPINGS=

# Dashboard / browser BFF. Bootstrap token is for local development only and stays server-side.
QUALYNTRA_DASHBOARD_HOST=127.0.0.1
QUALYNTRA_DASHBOARD_PORT=4320
QUALYNTRA_DASHBOARD_CONTROL_PLANE_ORIGIN=http://127.0.0.1:4317
QUALYNTRA_DASHBOARD_MAX_PROXY_BODY_BYTES=1048576
QUALYNTRA_DASHBOARD_MAX_PROXY_RESPONSE_BYTES=10485760
QUALYNTRA_DASHBOARD_BOOTSTRAP_TOKEN=
QUALYNTRA_DASHBOARD_BOOTSTRAP_ACTOR_ID=dashboard-bootstrap
QUALYNTRA_DASHBOARD_ORGANIZATION_ID=
QUALYNTRA_DASHBOARD_WORKSPACE_ID=
QUALYNTRA_DASHBOARD_PROJECT_ID=
QUALYNTRA_DASHBOARD_ENVIRONMENT_ID=

# Artifact service limits used by the control-plane reference deployment.
QUALYNTRA_ARTIFACT_MAX_BYTES=104857600
QUALYNTRA_ARTIFACT_DEFAULT_RETENTION_DAYS=30
QUALYNTRA_ARTIFACT_MAX_RETENTION_DAYS=365
QUALYNTRA_ARTIFACT_MAX_DOWNLOAD_GRANT_SECONDS=900

# Standalone execution agent. Prefer TOKEN_FILE for production secret rotation.
QUALYNTRA_AGENT_CONTROL_PLANE_ORIGIN=http://127.0.0.1:4317
QUALYNTRA_AGENT_ORGANIZATION_ID=
QUALYNTRA_AGENT_WORKSPACE_ID=
QUALYNTRA_AGENT_PROJECT_ID=
QUALYNTRA_AGENT_ENVIRONMENT_ID=
QUALYNTRA_AGENT_TOKEN_FILE=
QUALYNTRA_AGENT_TOKEN=
QUALYNTRA_AGENT_DATA_DIR=.qualyntra-agent
QUALYNTRA_AGENT_WORKSPACE_ROOT=.qualyntra-agent/work
QUALYNTRA_AGENT_SECRET_ROOT=/run/secrets
QUALYNTRA_AGENT_RUNNERS=
QUALYNTRA_AGENT_LABELS=
QUALYNTRA_AGENT_LANGUAGES=
QUALYNTRA_AGENT_ENGINES=
QUALYNTRA_AGENT_MAX_CONCURRENCY=1
QUALYNTRA_AGENT_POLL_MS=1000
QUALYNTRA_AGENT_HEARTBEAT_MS=10000
QUALYNTRA_AGENT_LEASE_MS=30000
QUALYNTRA_AGENT_WORKER_STALE_MS=60000
QUALYNTRA_AGENT_RETRY_DELAY_MS=1000
QUALYNTRA_AGENT_MAX_WORKSPACE_BYTES=2147483648
QUALYNTRA_AGENT_SHUTDOWN_GRACE_MS=30000
QUALYNTRA_AGENT_CLEANUP_WORKSPACES=true
QUALYNTRA_AGENT_ALLOW_ENV_SECRETS=false
QUALYNTRA_AGENT_HEALTH_HOST=127.0.0.1
QUALYNTRA_AGENT_HEALTH_PORT=4321
QUALYNTRA_AGENT_CUSTOM_COMMAND=
