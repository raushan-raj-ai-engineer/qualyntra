# File: .env.example
# Purpose: Documents optional runtime configuration without containing real credentials.
# Author: Raushan Raj

QUALYNTRA_HOST=127.0.0.1
QUALYNTRA_PORT=4317
QUALYNTRA_DATA_DIR=.qualyntra
QUALYNTRA_LOG_LEVEL=info
QUALYNTRA_DEFAULT_PROVIDER=mock
QUALYNTRA_ALLOW_NETWORK=false
QUALYNTRA_OPENAI_BASE_URL=
QUALYNTRA_OPENAI_API_KEY=
QUALYNTRA_OPENAI_MODEL=
QUALYNTRA_DEEPEVAL_PYTHON=python3

# Control-plane API bootstrap. Keep real tokens outside source control.
QUALYNTRA_API_TOKEN=
QUALYNTRA_API_ACTOR_ID=local-service
QUALYNTRA_API_ORGANIZATION_ID=
QUALYNTRA_API_MAX_BODY_BYTES=1048576
QUALYNTRA_API_MAX_PAGE_SIZE=100
QUALYNTRA_API_RATE_LIMIT_PER_MINUTE=120
QUALYNTRA_API_CORS_ORIGINS=
