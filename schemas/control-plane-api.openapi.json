{
  "x-file-purpose": "Defines the versioned Qualyntra Control Plane API surface, authentication, tenant headers, paging, and core operations.",
  "x-author": "Raushan Raj",
  "openapi": "3.1.0",
  "info": {
    "title": "Qualyntra Control Plane API",
    "version": "1.0.0",
    "description": "Vendor-neutral tenant-aware API for runs, results, distributed execution agents, artifacts, evaluations, governance, integrations, observability, alerts, and notifications."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "OrganizationId": {
        "name": "x-qualyntra-organization-id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "WorkspaceId": {
        "name": "x-qualyntra-workspace-id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "ProjectId": {
        "name": "x-qualyntra-project-id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "EnvironmentId": {
        "name": "x-qualyntra-environment-id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId",
              "correlationId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "correlationId": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      },
      "TenantScope": {
        "type": "object",
        "required": [
          "organizationId"
        ],
        "properties": {
          "organizationId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "environmentId": {
            "type": "string"
          }
        }
      },
      "IntegrationActionRequest": {
        "type": "object",
        "required": [
          "operation",
          "payload"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "publish-status",
              "create-work-item",
              "comment",
              "trigger-build",
              "notify",
              "custom"
            ]
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "NotificationActionRequest": {
        "type": "object",
        "required": [
          "title",
          "message",
          "severity"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
          "links": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "WorkerCapabilities": {
        "type": "object",
        "required": [
          "languages",
          "runners"
        ],
        "properties": {
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "engines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operatingSystems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AgentRegistrationRequest": {
        "type": "object",
        "required": [
          "id",
          "capabilities",
          "maxConcurrency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^worker_[A-Za-z0-9-]+$"
          },
          "capabilities": {
            "$ref": "#/components/schemas/WorkerCapabilities"
          },
          "maxConcurrency": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "online",
              "draining",
              "offline"
            ]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "AgentLeaseRequest": {
        "type": "object",
        "required": [
          "leaseMs",
          "workerStaleMs"
        ],
        "properties": {
          "leaseMs": {
            "type": "integer",
            "minimum": 5000,
            "maximum": 300000
          },
          "workerStaleMs": {
            "type": "integer",
            "minimum": 5000,
            "maximum": 900000
          }
        }
      },
      "AgentFailureRequest": {
        "type": "object",
        "required": [
          "message",
          "retryable"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "retryDelayMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "DistributedJobRequest": {
        "type": "object",
        "required": [
          "request"
        ],
        "properties": {
          "request": {
            "type": "object",
            "additionalProperties": true
          },
          "requirements": {
            "type": "object",
            "additionalProperties": true
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "security": [],
        "summary": "Readiness probe",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "summary": "Discover control-plane capabilities",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Capabilities"
          }
        }
      }
    },
    "/runs": {
      "get": {
        "summary": "List runs",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Paged runs"
          }
        }
      },
      "post": {
        "summary": "Queue a run",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "200": {
            "description": "Existing idempotent run"
          },
          "409": {
            "description": "Idempotency conflict"
          }
        }
      }
    },
    "/runs/{id}": {
      "get": {
        "summary": "Get a run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Run"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/runs/{id}/results": {
      "get": {
        "summary": "List normalized results for a run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Results"
          }
        }
      },
      "post": {
        "summary": "Store normalized results",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/evaluations": {
      "get": {
        "summary": "List evaluation records",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluations"
          }
        }
      },
      "post": {
        "summary": "Queue an evaluation record",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/evaluations/{id}": {
      "get": {
        "summary": "Get an evaluation record",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluation"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/policies": {
      "get": {
        "summary": "List release policies",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Policies"
          }
        }
      },
      "post": {
        "summary": "Store a release policy",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/releases/{id}/decision": {
      "get": {
        "summary": "Get a stored release decision",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Decision"
          }
        }
      },
      "post": {
        "summary": "Evaluate and store a release decision",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Decision"
          }
        }
      }
    },
    "/audit": {
      "get": {
        "summary": "List tenant-scoped audit records",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Audit records"
          }
        }
      }
    },
    "/adapters": {
      "get": {
        "summary": "List adapter descriptors",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Adapters"
          }
        }
      }
    },
    "/runtimes": {
      "get": {
        "summary": "List runtime adapter descriptors",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Runtimes"
          }
        }
      }
    },
    "/providers": {
      "get": {
        "summary": "List model-provider adapter descriptors",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Providers"
          }
        }
      }
    },
    "/integrations": {
      "get": {
        "summary": "List integration adapter descriptors",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Integrations"
          }
        }
      }
    },
    "/integrations/{id}/actions": {
      "post": {
        "summary": "Execute an integration operation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required by duplicate-sensitive integration mutations such as issue/work-item creation and build triggering."
          }
        ],
        "responses": {
          "200": {
            "description": "Integration response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntegrationActionRequest"
              }
            }
          }
        }
      }
    },
    "/observability/summary": {
      "get": {
        "summary": "Get tenant-scoped observability summary",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/EnvironmentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Telemetry, health, and alert summary"
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "summary": "List recent tenant-scoped alerts",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/EnvironmentId"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Alert records"
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "summary": "List notification adapter descriptors",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/EnvironmentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Notification adapters"
          }
        }
      }
    },
    "/notifications/{id}/actions": {
      "post": {
        "summary": "Send a notification through a registered adapter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/EnvironmentId"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notification delivery response"
          }
        }
      }
    },
    "/distributed/jobs": {
      "post": {
        "summary": "Enqueue a tenant-scoped distributed execution job",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/EnvironmentId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DistributedJobRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Distributed job created"
          }
        }
      }
    },
    "/agents/register": {
      "post": {
        "summary": "Register or refresh an execution agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/EnvironmentId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Worker registration"
          }
        }
      }
    },
    "/agents/{id}/heartbeat": {
      "post": {
        "summary": "Heartbeat or drain an execution agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/EnvironmentId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "online",
                      "draining",
                      "offline"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated worker registration"
          }
        }
      }
    },
    "/agents/{id}/lease": {
      "post": {
        "summary": "Lease the next compatible job for an execution agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/EnvironmentId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentLeaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job envelope; job is absent when no work is available"
          }
        }
      }
    },
    "/agent-jobs/{jobId}/leases/{leaseId}/heartbeat": {
      "post": {
        "summary": "Renew a job lease",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/EnvironmentId"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "leaseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "leaseMs"
                ],
                "properties": {
                  "leaseMs": {
                    "type": "integer",
                    "minimum": 5000,
                    "maximum": 300000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated distributed job"
          }
        }
      }
    },
    "/agent-jobs/{jobId}/leases/{leaseId}/running": {
      "post": {
        "summary": "Mark a leased job running",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/EnvironmentId"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "leaseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
