{
  "x-file-purpose": "Documents the non-secret standalone execution-agent configuration contract and deployment limits.",
  "x-author": "Raushan Raj",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qualyntra:schema:execution-agent-config:v1",
  "title": "Qualyntra Execution Agent Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["controlPlaneOrigin", "scope", "maxConcurrency", "leaseMs", "heartbeatMs", "workspaceRoot"],
  "properties": {
    "controlPlaneOrigin": { "type": "string", "format": "uri" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId"],
      "properties": {
        "organizationId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "environmentId": { "type": "string", "minLength": 1 }
      }
    },
    "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 128 },
    "leaseMs": { "type": "integer", "minimum": 5000, "maximum": 300000 },
    "heartbeatMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
    "workerStaleMs": { "type": "integer", "minimum": 5000, "maximum": 900000 },
    "pollMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "maxWorkspaceBytes": { "type": "integer", "minimum": 1048576 },
    "labels": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "languages": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "engines": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "runnerIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
