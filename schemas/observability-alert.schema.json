{
  "x-file-purpose": "Defines the portable Qualyntra metric alert-rule and notification-request schema.",
  "x-author": "Raushan Raj",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qualyntra:schema:observability-alert:v1",
  "title": "Qualyntra Observability Alert",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/alertRule" },
    { "$ref": "#/$defs/notificationRequest" }
  ],
  "$defs": {
    "tenantScope": {
      "type": "object",
      "required": ["organizationId"],
      "properties": {
        "organizationId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "environmentId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "alertRule": {
      "type": "object",
      "required": ["id", "name", "metric", "operator", "threshold", "severity", "cooldownSeconds", "notificationAdapterIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["gt", "gte", "lt", "lte", "eq", "neq"] },
        "threshold": { "type": "number" },
        "severity": { "enum": ["info", "warning", "critical"] },
        "cooldownSeconds": { "type": "integer", "minimum": 0 },
        "notificationAdapterIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "scope": { "$ref": "#/$defs/tenantScope" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "notificationRequest": {
      "type": "object",
      "required": ["id", "title", "message", "severity", "scope"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "message": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "severity": { "enum": ["info", "warning", "critical"] },
        "scope": { "$ref": "#/$defs/tenantScope" },
        "correlationId": { "type": "string" },
        "dedupeKey": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "links": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": { "label": { "type": "string" }, "url": { "type": "string" } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
