{
  "x-file-purpose": "Validates portable web/mobile executable automation plans independently of specific automation engines.",
  "x-author": "Raushan Raj",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "runId",
    "engine",
    "commands"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "browser": {
      "type": "string"
    },
    "headless": {
      "type": "boolean"
    },
    "baseUrl": {
      "type": "string"
    },
    "remoteUrl": {
      "type": "string"
    },
    "allowRemote": {
      "type": "boolean"
    },
    "artifactDirectory": {
      "type": "string"
    },
    "tracing": {
      "type": "boolean"
    },
    "timeoutMs": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "failFast": {
      "type": "boolean"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "navigate",
              "click",
              "fill",
              "select",
              "check",
              "screenshot",
              "custom",
              "tap",
              "clear",
              "swipe",
              "scroll",
              "pageSource",
              "activateApp",
              "terminateApp",
              "installApp",
              "removeApp",
              "executeMobile"
            ]
          },
          "url": {
            "type": "string"
          },
          "value": {},
          "locator": {
            "type": "object",
            "required": [
              "strategy",
              "value"
            ],
            "properties": {
              "strategy": {
                "enum": [
                  "role",
                  "label",
                  "text",
                  "testId",
                  "css",
                  "xpath",
                  "accessibilityId",
                  "custom",
                  "id",
                  "className",
                  "androidUiAutomator",
                  "iosPredicate",
                  "iosClassChain"
                ]
              },
              "value": {
                "type": "string"
              },
              "options": {
                "type": "object"
              }
            }
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "mobile": {
      "type": "object",
      "required": [
        "platform"
      ],
      "properties": {
        "platform": {
          "enum": [
            "android",
            "ios"
          ]
        },
        "serverUrl": {
          "type": "string"
        },
        "automationName": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        },
        "platformVersion": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "appId": {
          "type": "string"
        },
        "udid": {
          "type": "string"
        },
        "browserName": {
          "type": "string"
        },
        "noReset": {
          "type": "boolean"
        },
        "fullReset": {
          "type": "boolean"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "object"
        },
        "allowExecuteMobile": {
          "type": "boolean"
        },
        "allowUnsafeMobileCommands": {
          "type": "boolean"
        }
      }
    }
  }
}
